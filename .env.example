# Anthropic API key, used by src/llm/client.py's ClaudeLLMClient.
# Get one at https://console.anthropic.com/settings/keys
# Without this set, live-call tests (marked @pytest.mark.integration) are skipped
# automatically rather than failing — see src/llm/client.py and conftest.py.
ANTHROPIC_API_KEY=

# Optional: where the graph memory store persists to disk (JSON, networkx node-link
# format). If unset, the store is in-memory only for the lifetime of the process.
JARVIS_MEMORY_PATH=./data/memory_graph.json
