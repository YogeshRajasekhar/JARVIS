# ---------------- JARVIS v2 configuration ----------------
# Free LLM providers, tried in this order. Add at least one; more = more resilience to rate limits.
# Groq (fastest free tier):        https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (free Flash tier):  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# OpenRouter (free ":free" models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional local model on your laptop, e.g. http://127.0.0.1:11434
OLLAMA_URL=
# Optional, v1 compatibility (paid)
ANTHROPIC_API_KEY=
# Model overrides (defaults are fine)
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# GROQ_SMART_MODEL=llama-3.3-70b-versatile
# GEMINI_FAST_MODEL=gemini-2.5-flash-lite
# GEMINI_SMART_MODEL=gemini-2.5-flash
# "auto" (cloud models + offline fallback) or "offline" (rule engine only)
JARVIS_LLM_MODE=auto

# ---------------- You ----------------
JARVIS_USER_NAME=Yogesh
JARVIS_TIMEZONE=Asia/Kolkata

# ---------------- Security ----------------
# Pairing token the phone must present. Leave empty to auto-generate (printed at start-up).
JARVIS_DEVICE_TOKEN=
# Key that encrypts OAuth tokens at rest. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
JARVIS_DATA_KEY=
# Origins allowed to call the API from a browser context. The Android app is https://localhost.
JARVIS_ALLOWED_ORIGINS=https://localhost

# ---------------- Storage ----------------
JARVIS_DB_PATH=./data/jarvis.db
# 1 = seed the mock calendar/inbox with demo data (virtual phone). Set 0 once real accounts are connected.
JARVIS_SEED_DEMO=1

# ---------------- Integrations (empty = mock) ----------------
# Google Calendar + Gmail: OAuth client JSON from Google Cloud Console, then run scripts/google_auth.py once.
GOOGLE_CREDENTIALS_PATH=
# Slack user token (xoxp-...) with channels:history, channels:read, chat:write, users:read, im:history
SLACK_USER_TOKEN=
# GitHub fine-grained token: read Issues/PRs/Actions/Notifications, write Issues
GITHUB_TOKEN=
GITHUB_USER=YogeshRajasekhar
