<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The JARVIS server is reached over TLS (Tailscale or a TLS proxy); no plaintext anywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
